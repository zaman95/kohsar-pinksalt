# ---- Site ----
# Public site URL, used for canonical URLs, sitemap.xml, robots.txt and JSON-LD
NEXT_PUBLIC_SITE_URL=https://kohsarsaltworks.com

# ---- Sanity (sanity.io) ----
# Create a project at https://www.sanity.io/manage (or run `npx sanity init` in this folder)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Only needed for scripts/seed.ts and any authenticated writes — create at
# https://www.sanity.io/manage -> API -> Tokens (Editor permission)
SANITY_API_WRITE_TOKEN=

# ---- Resend (resend.com) ----
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=
# Verified sending domain/address in Resend, e.g. quotes@kohsarsaltworks.com
RESEND_FROM_EMAIL=Kohsar Saltworks <quotes@kohsarsaltworks.com>
# Where quote/contact form submissions should be delivered
SALES_INBOX_EMAIL=export@kohsarsaltworks.com

# ---- Analytics ----
# GA4 Measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Microsoft Clarity project ID
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# Google Search Console HTML tag verification token (the "content" value only)
NEXT_PUBLIC_GSC_VERIFICATION=
